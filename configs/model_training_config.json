{
  "tune": true,
  "n_trials": 5,
  "timeout": 600,
  "register": true,
  "promotion_metric": "f1_macro",
  "promotion_min_delta": 0.01,
  "force_promote": false,
  "log_optuna_trials": false,
  "enabled_models": [
    "logistic_regression",
    "random_forest"
  ],
  "optuna": {
    "n_splits": 3,
    "random_state": 42
  },
  "search_space": {
    "logistic_regression": {
      "C": {
        "low": 0.001,
        "high": 10.0,
        "log": true
      },
      "penalty": [
        "l2"
      ],
      "solver": [
        "lbfgs",
        "liblinear"
      ],
      "max_iter": 2000,
      "class_weight": "balanced"
    },
    "random_forest": {
      "n_estimators": {
        "low": 100,
        "high": 600,
        "step": 50
      },
      "max_depth": {
        "low": 3,
        "high": 20
      },
      "min_samples_split": {
        "low": 2,
        "high": 20
      },
      "min_samples_leaf": {
        "low": 1,
        "high": 10
      },
      "max_features": [
        "sqrt",
        "log2",
        null
      ],
      "class_weight": "balanced",
      "n_jobs": -1
    },
    "xgboost": {
      "n_estimators": {
        "low": 100,
        "high": 600,
        "step": 50
      },
      "max_depth": {
        "low": 3,
        "high": 10
      },
      "learning_rate": {
        "low": 0.001,
        "high": 0.3,
        "log": true
      },
      "subsample": {
        "low": 0.6,
        "high": 1.0
      },
      "colsample_bytree": {
        "low": 0.6,
        "high": 1.0
      },
      "min_child_weight": {
        "low": 1,
        "high": 10
      },
      "gamma": {
        "low": 0.0,
        "high": 5.0
      },
      "reg_lambda": {
        "low": 0.001,
        "high": 10.0,
        "log": true
      },
      "eval_metric": "logloss"
    }
  }
}
